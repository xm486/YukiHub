<?xml version="1.0" encoding="utf-8"?>
<!--
  设置面板（spec §S6）—— 左侧五分区、右侧条目（条目显示当前值）
  ← → 切换分区，↑↓ 选择条目，Ⓐ 修改（数值项走 S8 选择器），Ⓑ 关闭
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bsSetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F005070E"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        android:paddingTop="40dp"
        android:paddingBottom="36dp">

        <!-- 左：五个分区 -->
        <LinearLayout
            android:id="@+id/bsSetLeftCol"
            android:layout_width="228dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="14dp"
                android:text="SETTINGS"
                android:letterSpacing="0.2"
                android:textSize="12sp"
                android:textColor="#6E7BA0" />

            <LinearLayout
                android:id="@+id/bsSetSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 右：当前分区的条目 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="34dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bsSetSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="10dp"
                android:singleLine="true"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/bs_text" />

            <ScrollView
                android:id="@+id/bsSetItemsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/bsSetItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/bsSetHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="52dp"
        android:layout_marginBottom="12dp"
        android:textSize="12sp"
        android:textColor="#7C89AF" />
</FrameLayout>