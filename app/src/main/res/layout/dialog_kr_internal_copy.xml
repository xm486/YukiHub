<?xml version="1.0" encoding="utf-8"?>
<!--
  KRKR 内部存储：复制进度窗口。
  自绘卡片，不依赖系统 AlertDialog 主题，避免浅色主题下「白底白字」。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_auth_dialog"
    android:padding="22dp">

    <!-- 标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="正在复制到内部存储"
            android:textColor="@color/yh_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCopyGame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="28dp"
        android:maxLines="1"
        android:ellipsize="middle"
        android:textColor="@color/yh_text_muted"
        android:textSize="12sp" />

    <!-- 大号百分比 -->
    <TextView
        android:id="@+id/tvCopyPercent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="0%"
        android:textColor="@color/yh_primary"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-light" />

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/pbCopy"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_progress_kr" />

    <TextView
        android:id="@+id/tvCopySize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="— / —"
        android:textColor="@color/yh_text_muted"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="#1A2744" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="首次复制需要一些时间，请勿退出应用\n复制完成后将自动启动游戏"
        android:textColor="@color/yh_text_muted"
        android:textSize="11sp" />
</LinearLayout>
