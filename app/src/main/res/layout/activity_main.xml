<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.yuki.yukihub.ui.DynamicSnowBackgroundView
        android:id="@+id/dynamicBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111A3A" />

    <ImageView
        android:id="@+id/customBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextureView
        android:id="@+id/customBackgroundVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/customBackgroundDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66030812"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="#00000000">

    <!-- ===== 左侧栏：头像 + 导航按钮 + 统计 ===== -->
    <LinearLayout
        android:layout_width="76dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 头像 + 问候 -->
        <LinearLayout
            android:id="@+id/profileContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:id="@+id/profilePanel"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:background="@drawable/bg_home_icon_circle"
                android:clipToOutline="true">
                <ImageView android:id="@+id/ivProfileAvatar" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
                <TextView android:id="@+id/tvProfileInitial" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Y" android:textColor="@color/yh_text" android:textSize="16sp" android:textStyle="bold" />
                <View android:id="@+id/profileStatusDot" android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="bottom|end" android:layout_margin="2dp" android:background="@drawable/bg_profile_dot_local" />
            </FrameLayout>

            <TextView android:id="@+id/tvProfileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="Yuki" android:textColor="@color/yh_text" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />

            <TextView android:id="@+id/tvGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="欢迎回来" android:textColor="@color/yh_text_muted" android:textSize="7sp" android:maxLines="2" />
        </LinearLayout>

        <!-- 导航按钮 -->
        <LinearLayout
            android:id="@+id/navContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_sidebar"
            android:padding="4dp"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_sidebar_item"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">
                <TextView android:layout_width="match_parent" android:layout_height="20dp" android:gravity="bottom|center_horizontal" android:text="⌂" android:textColor="#E8FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="14dp" android:gravity="top|center_horizontal" android:text="首页" android:textColor="#E8FFFFFF" android:textSize="7sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navLibrary"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="3dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_home_nav_active"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">
                <TextView android:layout_width="match_parent" android:layout_height="20dp" android:gravity="bottom|center_horizontal" android:text="🎮" android:textColor="#FFFFFFFF" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="14dp" android:gravity="top|center_horizontal" android:text="游戏库" android:textColor="#FFFFFFFF" android:textSize="7sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navBigScreen"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="3dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_sidebar_item"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">
                <TextView android:layout_width="match_parent" android:layout_height="20dp" android:gravity="bottom|center_horizontal" android:text="▣" android:textColor="#E8FFFFFF" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="14dp" android:gravity="top|center_horizontal" android:text="大屏" android:textColor="#E8FFFFFF" android:textSize="7sp" />
            </LinearLayout>

            <FrameLayout
                 android:id="@+id/navChat"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="3dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_sidebar_item"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="20dp" android:gravity="bottom|center_horizontal" android:text="💬" android:textColor="#E8FFFFFF" android:textSize="12sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="14dp" android:gravity="top|center_horizontal" android:text="好友/聊天" android:textColor="#E8FFFFFF" android:textSize="7sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/navChatBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="1dp"
                    android:gravity="center"
                    android:textColor="#FFFFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_unread_badge"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/navTranslate"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="3dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_sidebar_item"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">
                <TextView android:layout_width="match_parent" android:layout_height="20dp" android:gravity="bottom|center_horizontal" android:text="🌐" android:textColor="#E8FFFFFF" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="14dp" android:gravity="top|center_horizontal" android:text="翻译" android:textColor="#E8FFFFFF" android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- 底栏统计：两个横向胶囊（游戏数 / 游玩时长）

             设计要点：
             - 不写「游玩统计」标题，图标已经表意，省下的高度给胶囊
             - 图标和数字同一行横排，比原来的竖排 "\n" 省高度也不易折行
             - 字号保持 sp（跟随设置里的全局字体缩放），但初始值压到 9sp。
               侧栏净宽只有约 60dp，放大到 130% 时约 11.7sp，仍放得下
             - 图标+数字作为一个整体居中：数字不用 weight 撑满，否则短数字
               （如 "30"）会靠左，右边空一大片很难看
             - maxLines=1 + autoSize 兜底：时长破 1000h（1234.5h，7 字符）
               时自动缩字而不是截断
        -->
        <LinearLayout
            android:id="@+id/statsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_sidebar"
            android:padding="5dp"
            android:layout_marginTop="4dp">

            <!-- 游戏数（青蓝） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="21dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_stat_pill_games">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮"
                    android:textSize="8sp"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/tvStatsGames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="0"
                    android:textColor="#EAF6FF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 游玩时长（品红紫，跟上面的青蓝拉开色相差） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="21dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_stat_pill_time">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕐"
                    android:textSize="8sp"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/tvStatsTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="0h"
                    android:textColor="#FFEAF7"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 中间区：顶栏 + 分类 + 游戏列表 + 右侧详情 ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="6dp">

        <!-- 顶栏：搜索 + 扫描 + 添加 | logo + 设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="4dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:hint="搜索Galgame标题..."
                android:textColor="@color/yh_text"
                android:textColorHint="@color/yh_text_muted"
                android:textSize="9sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_input" />

            <FrameLayout android:id="@+id/btnScan" android:layout_width="62dp" android:layout_height="28dp" android:layout_marginStart="8dp" android:background="@drawable/bg_yuki_button" android:foreground="?android:attr/selectableItemBackgroundBorderless">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="⌕ 扫描" android:textColor="#000000" android:textSize="9sp" android:textStyle="bold" />
                <ImageView android:id="@+id/ivScanLoading" android:layout_width="11dp" android:layout_height="11dp" android:layout_gravity="center_vertical|end" android:layout_marginEnd="4dp" android:src="@android:drawable/ic_popup_sync" android:tint="#EAF7FF" android:visibility="gone" />
            </FrameLayout>
            <TextView android:id="@+id/btnAdd" android:layout_width="62dp" android:layout_height="28dp" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/bg_yuki_button" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:text="＋ 添加" android:textColor="#000000" android:textSize="9sp" android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTitleTop"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="❄YukiHub"
                android:textColor="#CFE8F7"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.012"
                android:shadowColor="#455AC8FA"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="62dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/bg_yuki_button"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:text="⚙ 设置"
                android:textColor="#000000"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 分类横排 + 状态信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="false"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/filterBar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView android:id="@+id/filterAll" android:layout_width="wrap_content" android:minWidth="56dp" android:layout_height="28dp" android:gravity="center" android:text="全部" android:textColor="@color/yh_text" android:textSize="8sp" android:textStyle="bold" android:background="@drawable/bg_input" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:paddingStart="10dp" android:paddingEnd="10dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/filterFavorite" android:layout_width="wrap_content" android:minWidth="56dp" android:layout_height="28dp" android:gravity="center" android:text="♡ 收藏" android:textColor="@color/yh_text" android:textSize="8sp" android:textStyle="bold" android:background="@drawable/bg_input" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/filterRecent" android:layout_width="wrap_content" android:minWidth="56dp" android:layout_height="28dp" android:gravity="center" android:text="本地游戏" android:textColor="@color/yh_text" android:textSize="8sp" android:textStyle="bold" android:background="@drawable/bg_input" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/filterPlaying" android:layout_width="wrap_content" android:minWidth="56dp" android:layout_height="28dp" android:gravity="center" android:text="在玩" android:textColor="@color/yh_text" android:textSize="8sp" android:textStyle="bold" android:background="@drawable/bg_input" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/filterCompleted" android:layout_width="wrap_content" android:minWidth="56dp" android:layout_height="28dp" android:gravity="center" android:text="玩过" android:textColor="@color/yh_text" android:textSize="8sp" android:textStyle="bold" android:background="@drawable/bg_input" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/filterUnplayed" android:layout_width="wrap_content" android:minWidth="56dp" android:layout_height="28dp" android:gravity="center" android:text="未玩" android:textColor="@color/yh_text" android:textSize="8sp" android:textStyle="bold" android:background="@drawable/bg_input" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/filterDeveloper" android:layout_width="wrap_content" android:minWidth="56dp" android:layout_height="28dp" android:gravity="center" android:text="▸ 开发商" android:textColor="@color/yh_text" android:textSize="8sp" android:textStyle="bold" android:background="@drawable/bg_input" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/btnSort" android:layout_width="wrap_content" android:minWidth="56dp" android:layout_height="28dp" android:gravity="center" android:text="⇅ 排序" android:textColor="@color/yh_text" android:textSize="8sp" android:textStyle="bold" android:background="@drawable/bg_input" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="4dp" android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 状态信息区：时间 | 电量 | 通知 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tvClock"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:text="🕐 00:00"
                    android:textColor="@color/yh_text"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_input"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvBatteryLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:text="🔋100%"
                    android:textColor="@color/yh_text"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_input"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:layout_marginEnd="4dp" />

                <FrameLayout
                    android:id="@+id/btnNotice"
                    android:layout_width="30dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_status_item"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="通知"
                        android:src="@drawable/ic_home_notification" />

                    <View
                        android:id="@+id/noticeRedDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="top|right"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_profile_dot_expired"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 开发商下拉区域 -->
        <LinearLayout
            android:id="@+id/developerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- 游戏列表 + 右侧详情 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerGames" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingEnd="4dp" android:paddingBottom="10dp" />
                <TextView android:id="@+id/tvEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:text="还没有游戏\n点击「添加」手动录入，或点击「扫描」导入目录" android:textColor="@color/yh_text_muted" android:textSize="16sp" android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="152dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:padding="1dp"
                android:clipToPadding="true"
                android:background="@drawable/bg_game_card">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="false"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="none"
                    android:clipToPadding="true">

                    <LinearLayout
                        android:id="@+id/detailPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <FrameLayout android:layout_width="match_parent" android:layout_height="82dp" android:background="@drawable/bg_cover_placeholder">
                            <ImageView android:id="@+id/sideDetailCover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
                            <TextView android:id="@+id/sideDetailPlaceholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="选择游戏" android:textColor="@color/yh_text_muted" android:textSize="9sp" android:textStyle="bold" />
                            <ProgressBar android:id="@+id/sideDetailCoverLoading" style="?android:attr/progressBarStyleSmall" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:indeterminate="true" android:visibility="gone" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:id="@+id/sideDetailTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" android:text="请选择游戏" android:textColor="@color/yh_text" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/sideMetadataSourceBadge" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_marginStart="4dp" android:gravity="center" android:background="@drawable/bg_chip" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="VNDB" android:textColor="@color/yh_primary" android:textSize="7sp" android:textStyle="bold" android:singleLine="true" android:visibility="gone" />
                        </LinearLayout>
                        <TextView android:id="@+id/sideDetailOriginalTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:maxLines="1" android:ellipsize="end" android:text="" android:textColor="@color/yh_text_muted" android:textSize="8sp" />

