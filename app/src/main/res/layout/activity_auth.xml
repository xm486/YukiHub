<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/authScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@drawable/bg_auth_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- Header：Logo 居中，关闭按钮压在右上角。
             用 FrameLayout 让关闭按钮不占据独立行、也不挤压 Logo 的居中位置。 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <!-- Logo section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❄"
                    android:textSize="28sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvAuthLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YukiHub"
                    android:textColor="#EAF7FF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:shadowColor="#455AC8FA"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="12" />

                <TextView
                    android:id="@+id/tvAuthSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="连接你的游戏库"
                    android:textColor="#5A6A8A"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 关闭按钮：替代原先「点击弹窗外部关闭」的行为。
                 那个行为会让用户切去邮箱看验证码回来时发现页面已关，填的内容全丢。 -->
            <TextView
                android:id="@+id/btnAuthClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|top"
                android:text="✕"
                android:textColor="#7A8BA8"
                android:textSize="17sp"
                android:gravity="center"
                android:background="@drawable/bg_auth_input"
                android:contentDescription="关闭"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <!-- Tab buttons -->
        <LinearLayout
            android:id="@+id/authTabRow"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_auth_tab_container"
            android:padding="3dp">

            <TextView
                android:id="@+id/tabLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="登录"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_auth_tab_active" />

            <TextView
                android:id="@+id/tabRegister"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="注册"
                android:textColor="#4A5568"
                android:textSize="14sp"
                android:background="@drawable/bg_auth_tab_inactive" />
        </LinearLayout>

        <!-- Form title -->
        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="欢迎回来"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFormHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="登录后开启云同步和跨设备恢复"
            android:textColor="#5A6A8A"
            android:textSize="11sp" />

        <!-- Nickname (register only) -->
        <LinearLayout
            android:id="@+id/rowNickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/labelNickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="昵称"
                android:textColor="#7A8BA8"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etNickname"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_auth_input"
                android:hint="你的显示名称"
                android:textColorHint="#3A4568"
                android:textColor="#EAF7FF"
                android:textSize="14sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:inputType="textPersonName" />
        </LinearLayout>

        <!-- Email -->
        <TextView
            android:id="@+id/labelEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="邮箱"
            android:textColor="#7A8BA8"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_auth_input"
            android:hint="name@example.com"
            android:textColorHint="#3A4568"
            android:textColor="#EAF7FF"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:inputType="textEmailAddress" />

        <!-- Email verify code (register only) - 邮箱验证码 -->
        <LinearLayout
            android:id="@+id/rowVerifyCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/labelVerifyCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="邮箱验证码"
                android:textColor="#7A8BA8"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etVerifyCode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_auth_input"
                    android:hint="输入邮箱验证码"
                    android:textColorHint="#3A4568"
                    android:textColor="#EAF7FF"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:inputType="number"
                    android:maxLength="6" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSendCode"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:text="发送验证码"
                    android:textColor="#5AC8FA"
                    android:textSize="13sp"
                    android:background="@drawable/bg_auth_input"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />
            </LinearLayout>

            <!-- 就近状态提示：底部的 tvAuthStatus 在长表单里常被挤出可视区，
                 用户点了发送却看不到任何反馈，会反复点击导致重复发码。
                 这一条紧贴验证码行，点完立刻能看到。 -->
            <TextView
                android:id="@+id/tvCodeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#8E9AB5"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Password label row：标签在左、忘记密码入口在右，
             复用这一行本来就空着的右侧，避免入口单独占一行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/labelPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="密码"
                android:textColor="#7A8BA8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="忘记密码？"
                android:textColor="#5AC8FA"
                android:textSize="12sp"
                android:paddingStart="16dp"
                android:paddingEnd="2dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_auth_input"
            android:hint="输入密码"
            android:textColorHint="#3A4568"
            android:textColor="#EAF7FF"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:inputType="textPassword" />

        <!-- Confirm password (register only) -->
        <LinearLayout
            android:id="@+id/rowConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/labelConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="确认密码"
                android:textColor="#7A8BA8"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_auth_input"
                android:hint="再次输入密码"
                android:textColorHint="#3A4568"
                android:textColor="#EAF7FF"
                android:textSize="14sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:inputType="textPassword" />
        </LinearLayout>
        <!-- Submit button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="18dp"
            android:text="登录"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_auth_button_primary"
            android:stateListAnimator="@null" />

        <!-- Status message -->
        <TextView
            android:id="@+id/tvAuthStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#FF9500"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#1A2240" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="或"
                android:textColor="#3A4A6A"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#1A2240" />
        </LinearLayout>

        <!-- KUN quick login — 鲲站快捷登录 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnKungalLogin"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:text="鲲 Galgame 账号登录"
            android:textColor="#EAF7FF"
            android:textSize="14sp"
            android:drawableStart="@drawable/ic_kungal_logo"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_kungal_card"
            android:stateListAnimator="@null" />

        <!-- Hikarinagi quick login — Hikarinagi 快捷登录 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHikarinagiLogin"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:text="Hikarinagi 账号登录"
            android:textColor="#EAF7FF"
            android:textSize="14sp"
            android:drawableStart="@drawable/ic_hikarinagi_logo"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_kungal_card"
            android:stateListAnimator="@null" />

        <!-- Continue as local -->
        <TextView
            android:id="@+id/tvContinueLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="继续使用本地账户"
            android:textColor="#5AC8FA"
            android:textSize="13sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>