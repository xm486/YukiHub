<?xml version="1.0" encoding="utf-8"?>
<!--
  KRKR 内部存储：管理窗口。
  自绘卡片 + 顶部统计条 + 可滚动列表，不依赖系统 AlertDialog 主题。
  列表行由代码动态填充（loadKrInternalList）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_auth_dialog"
    android:padding="20dp">

    <!-- 标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="内部存储管理"
            android:textColor="@color/yh_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvKrMgrClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="✕"
            android:textColor="@color/yh_text_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 统计条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_auth_input"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvKrMgrSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="正在统计…"
            android:textColor="@color/yh_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbKrMgrUsage"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_kr" />
    </LinearLayout>

    <!-- 列表 -->
    <ScrollView
        android:id="@+id/svKrMgrList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="80dp"
        android:maxHeight="320dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/llKrMgrList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#1A2744" />

    <!-- 底部操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKrMgrClearAll"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_tool"
            android:text="全部清理"
            android:textColor="@color/yh_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnKrMgrDone"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_action_primary"
            android:text="完成"
            android:textColor="#F5F4FF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>