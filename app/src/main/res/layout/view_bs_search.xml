<?xml version="1.0" encoding="utf-8"?>
<!--
  大屏模式「搜索」浮层（M22）—— 挂到 bsOverlayLayer 最上层。
  结构：全屏压暗遮罩 → 居中玻璃卡片（输入行 + 结果网格 + 底部提示）。
  触摸：点卡片外的遮罩 = 关闭；手柄：Ⓑ 关闭。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bsSearchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC05070E"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/bsSearchCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="44dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_bs_panel"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:clickable="true">

        <!-- 输入行：放大镜 + 输入框 + 结果计数 + 关闭 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_st_search"
                android:tint="@color/bs_text_muted" />

            <EditText
                android:id="@+id/bsSearchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="搜索标题 / 会社名…"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/bs_text"
                android:textColorHint="@color/bs_text_muted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/bsSearchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/bs_text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/bsSearchClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_bs_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="✕"
                android:textColor="@color/bs_text"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#3C4874" />

        <!-- 结果区：网格（复用 item_bs_card） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bsSearchResults"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/bsSearchEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="没有匹配的游戏"
                android:textColor="@color/bs_text_muted"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/bsSearchHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/bs_text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
