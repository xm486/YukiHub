<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#99172039" />
            <stroke android:width="1dp" android:color="#38677F9F" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EE303E59" />
            <stroke android:width="1dp" android:color="#857790B9" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#EE25324C" />
            <stroke android:width="1dp" android:color="#857790B9" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC172039" />
            <stroke android:width="1dp" android:color="#52677F9F" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
