<?xml version="1.0" encoding="utf-8"?>
<!--
  侧栏统计胶囊 · 游戏数（青蓝）

  沿用 bg_sidebar 的双层手法：外层渐变 + 描边，内层再叠一道极淡白线做内高光，
  在深色背景上有轻微玻璃质感。

  配色刻意偏青（#4FC3F7 系）而不是纯蓝，为了跟下面时长胶囊的品红紫拉开色相差。
  第一版两个胶囊都用蓝系，实机上几乎看不出区别，白做了。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="#4529A8CC"
                android:endColor="#2E1C6E96"
                android:angle="315" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#6E4FC3F7" />
        </shape>
    </item>
    <!-- 内高光：比外描边淡得多，只为让边缘有层次 -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#18FFFFFF" />
        </shape>
    </item>
</layer-list>