    android:width="22dp"
    android:height="22dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 电池外壳 -->
    <path
        android:pathData="M4,7.5h13.5a2,2 0 0 1 2,2v5a2,2 0 0 1 -2,2H4a2,2 0 0 1 -2,-2v-5a2,2 0 0 1 2,-2z"
        android:strokeWidth="1.8"
        android:strokeColor="#FFFFFF"
        android:fillColor="#00000000" />

    <!-- 正极凸起 -->
    <path
        android:pathData="M21.2,10.2h0.6a0.9,0.9 0 0 1 0.9,0.9v1.8a0.9,0.9 0 0 1 -0.9,0.9h-0.6z"
