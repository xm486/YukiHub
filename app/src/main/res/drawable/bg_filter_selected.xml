<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#254F467F" />
            <stroke android:width="1dp" android:color="#387F75B5" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#704F467F" />
            <stroke android:width="1dp" android:color="#FFA098C8" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#604F467F" />
            <stroke android:width="1dp" android:color="#FFA098C8" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#454F467F" />
            <stroke android:width="1dp" android:color="#807F75B5" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
