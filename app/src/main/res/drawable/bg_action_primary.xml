<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF363C60" />
            <stroke android:width="1dp" android:color="#FF555C83" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF484E88" />
            <stroke android:width="1dp" android:color="#FF858BC4" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF5B62A3" />
            <stroke android:width="1dp" android:color="#FFA0A6DE" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF565D9E" />
            <stroke android:width="1dp" android:color="#FF858BC4" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
