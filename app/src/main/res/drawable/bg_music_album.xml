<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐库：专辑条目卡片（深色玻璃，圆角，细边） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="#E4162038"
                android:centerColor="#D9131B30"
                android:endColor="#D80E1526"
                android:angle="270" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#467AA7D6" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="#12FFFFFF" />
        </shape>
    </item>
</layer-list>
