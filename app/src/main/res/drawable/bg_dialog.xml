<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗内容背景（全局共用）。
  ================================================================
  这个文件被 20 处 setBackgroundResource(R.drawable.bg_dialog) 直接引用，
  是「弹窗里面那块板子」的实际外观来源。

  之前一直是：纯色 #10172A + 10dp 圆角 + 固定灰蓝描边 #3B4B7A。
  用户反馈「和新的同步 UI 比太丑」，主要就是这块板子的问题：
    - 圆角只有 10dp，显得硬、老气
    - 纯色没层次，像贴了张纸
    - 描边是固定色，和主题主色没关系

  现在改成与同步弹窗/同步卡片一致的视觉语言：
    - 圆角 10dp -> 18dp
    - 纯色 -> 上浅下深竖向渐变（制造纵深，不再是死板一块）
    - 描边 -> 主题主色的半透明版本

  注意：动态主题开启时，代码里会用 tintDialog() 直接重绘覆盖，
  两者互不冲突——开着动态主题时依然由代码接管。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F71E2740"
        android:centerColor="#F7171E33"
        android:endColor="#F7111930"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#3D8AB4FF" />
    <corners android:radius="18dp" />
</shape>