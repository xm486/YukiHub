<?xml version="1.0" encoding="utf-8"?>
<!--
  全局弹窗背景（v2）。
  与旧的 bg_dialog.xml 的区别：
    - 圆角 10dp → 18dp（与同步弹窗、同步卡片统一）
    - 纯色 → 竖向渐变（上浅下深，制造一点纵深，不再是「一块死板子」）
    - 描边固定色 → 主题色半透明，动态主题开启时自动跟随
  旧文件保留不动（还有 33 处 setBackgroundResource 引用它），
  本文件只给 alertDialogTheme 用。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F21E2740"
        android:centerColor="#F2171E33"
        android:endColor="#F2111930"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#3D8AB4FF" />
    <corners android:radius="18dp" />
</shape>