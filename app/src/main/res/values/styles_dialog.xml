<?xml version="1.0" encoding="utf-8"?>
<!--
  全局弹窗样式（方案 A）。
  ================================================================
  为什么在主题里改，而不是改 120+ 处 AlertDialog.Builder 调用点：
    1. 调用点全是 .setTitle() / .setMessage() / .setPositiveButton() 标准链，
       换壳不该动它们；动了容易漏改、改错，还会让 diff 变脏。
    2. Activity 继承 Theme.MaterialComponents.NoActionBar，
       Material 1.9.0 支持 alertDialogTheme / materialAlertDialogTheme
       统一下发弹窗样式——这是官方给的正路。
    3. 一处生效、可整体回滚。

  注意：这里的父 style 名必须与 Material 1.9.0 实际提供的完全一致，
  写错任何一个都会导致资源编译失败（AAPT: resource style/xxx not found）。
  因此只使用确定存在的：
    - ThemeOverlay.MaterialComponents.MaterialAlertDialog
    - Widget.MaterialComponents.Button.TextButton.Dialog
  标题/正文样式用 item 直接覆盖属性，不再继承不确定的父级。
-->
<resources>

    <!-- ==================== 全局弹窗主题 ==================== -->
    <style name="Theme.YukiHub.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- 背景：竖向渐变 + 18dp 圆角 + 主题色描边（drawable 提供） -->
        <item name="android:windowBackground">@drawable/bg_dialog_v2</item>
        <item name="android:backgroundDimAmount">0.66</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowMinWidthMajor">44%</item>
        <item name="android:windowMinWidthMinor">82%</item>

        <!-- 按钮：正按钮主色加粗，其余低调 -->
        <item name="buttonBarPositiveButtonStyle">@style/YukiHub.DialogButtonPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/YukiHub.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/YukiHub.DialogButton</item>

        <!-- 标题 / 正文配色与字号（直接覆盖属性，不依赖不确定的父级名） -->
        <item name="android:textColorPrimary">@color/yh_text</item>
        <item name="android:textColorSecondary">@color/yh_text_muted</item>
        <item name="android:textColorHint">@color/yh_text_muted</item>
        <item name="colorPrimary">@color/yh_primary</item>
        <item name="colorSecondary">@color/yh_primary</item>
        <item name="colorSurface">@color/yh_card</item>
        <item name="colorOnSurface">@color/yh_text</item>
        <item name="android:colorAccent">@color/yh_primary</item>
    </style>

    <!-- 普通按钮：透明底 + 圆角 + 按下涟漪 -->
    <style name="YukiHub.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/yh_text_muted</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">10dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- 正按钮：主色 + 加粗，视觉上突出「主要动作」 -->
    <style name="YukiHub.DialogButtonPositive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/yh_primary</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">10dp</item>
        <item name="rippleColor">#4D8AB4FF</item>
    </style>

</resources>