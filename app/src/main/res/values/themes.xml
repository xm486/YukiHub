<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/yh_bg</item>
        <item name="android:colorAccent">@color/yh_primary</item>
        <item name="colorPrimary">@color/yh_primary</item>
        <item name="colorPrimaryVariant">@color/yh_bg_2</item>
        <item name="colorOnPrimary">@color/yh_bg</item>

        <!-- 全局弹窗外观（圆角 18dp / 渐变底 / 主题色描边 / 自绘按钮）。
             这一行让全项目 120+ 处 AlertDialog 统一换壳，调用代码一行不用动。
             具体样式见 values/styles_dialog.xml。 -->
        <item name="alertDialogTheme">@style/Theme.YukiHub.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.YukiHub.AlertDialog</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <style name="Theme.YukiHub.Kirikiroid2" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
<item name="android:backgroundDimAmount">1.0</item>
<item name="android:backgroundDimEnabled">true</item>
<item name="android:windowNoTitle">true</item>
<item name="android:windowActionBar">false</item>
<item name="android:windowFullscreen">true</item>
<item name="android:windowDisablePreview">true</item>
</style>

<style name="Theme.YukiHub.Kirikiroid2Compatible" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
<item name="android:windowNoTitle">true</item>
<item name="android:windowActionBar">false</item>
<item name="android:windowFullscreen">true</item>
</style>

<!-- Shared view styles are defined in values/styles.xml. -->
</resources>